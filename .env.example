# Copy to .env (or export in the shell) to override defaults.

# Downstream vLLM OpenAI-compatible endpoint (used by the FastAPI gateway)
VLLM_BASE_URL=http://127.0.0.1:9033

# Model name sent to vLLM in every request; must match the served model name
VLLM_MODEL_NAME=openbmb/MiniCPM5-2B-GPTQ

# vLLM request timeout in seconds
VLLM_TIMEOUT=120

# FastAPI gateway endpoint (used by the Streamlit UI)
API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Docker Compose (docker-compose.yml) — copy to .env to override. `.env` is
# gitignored; never commit real values such as HF_TOKEN.
# ---------------------------------------------------------------------------

# vLLM upstream image (with AWQ/Marlin support). Tag should match the vLLM
# version served by the image.
VLLM_IMAGE=vllm/vllm-openai:v0.24.0

# Hugging Face model served by the vLLM container.
# Note: reputation contains GPTQ; vLLM consumes it via the AWQ runtime path.
MODEL_ID=openbmb/MiniCPM5-2B-GPTQ
SERVED_MODEL_NAME=openbmb/MiniCPM5-2B-GPTQ

# vLLM runtime tuning inside the container.
VLLM_GPU_MEM_UTIL=0.30
VLLM_MAX_MODEL_LEN=512

# Optional token for gated Hugging Face models (never commit).
# HF_TOKEN=hf_...

# Container-to-container endpoints use Docker service names (do not change):
#   api -> vllm:       http://vllm:8000
#   streamlit -> api:  http://api:8000